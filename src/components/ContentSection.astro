---
import type { ContentSection } from '../types/converter';

interface Props {
  sections: ContentSection[];
}

const { sections } = Astro.props;
// 标题转锚点 id，支持目录跳转与富语义结构
function slugify(heading: string): string {
  return heading.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
---

<section class="mx-auto mt-16 max-w-4xl" aria-labelledby="content-title">
  <h2 id="content-title" class="mb-6 text-2xl font-semibold tracking-[-0.025em] text-stone-950 sm:text-3xl">About this converter</h2>
  <div class="space-y-10">
    {sections.map((section) => {
      const id = slugify(section.heading);
      return (
        <article aria-labelledby={id}>
          <h3 id={id} class="text-xl font-semibold tracking-tight text-stone-950">{section.heading}</h3>
          {section.body.map((paragraph) => (
            <p class="mt-3 max-w-3xl leading-7 text-stone-600">{paragraph}</p>
          ))}
        </article>
      );
    })}
  </div>
</section>
