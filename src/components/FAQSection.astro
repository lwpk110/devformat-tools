---
import type { FAQItem } from '../types/converter';

interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<section class="mx-auto mt-16 max-w-4xl" aria-labelledby="faq-title">
  <div class="mb-5 border-b border-stone-200 pb-4">
    <h2 id="faq-title" class="text-2xl font-semibold tracking-[-0.025em] text-stone-950 sm:text-3xl">Frequently asked questions</h2>
  </div>
  <div class="divide-y divide-stone-200">
    {items.map((item) => (
      <details class="group py-5">
        <summary class="cursor-pointer list-none pr-8 font-medium text-stone-950 marker:hidden">
          <span class="flex items-start justify-between gap-5">
            {item.q}
            <span aria-hidden="true" class="text-lg text-teal-800 transition-transform group-open:rotate-45">+</span>
          </span>
        </summary>
        <p class="max-w-3xl pt-3 leading-7 text-stone-600">{item.a}</p>
      </details>
    ))}
  </div>
</section>
