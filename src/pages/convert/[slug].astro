---
import ConverterTool from '../../components/ConverterTool';
import ContentSection from '../../components/ContentSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import convertersData from '../../data/converters.json';
import Layout from '../../layouts/Layout.astro';
import type { ConverterData } from '../../types/converter';

const converters = convertersData as ConverterData[];

export function getStaticPaths() {
  return (convertersData as ConverterData[]).map((converter) => ({
    params: { slug: converter.slug },
    props: { converter },
  }));
}

interface Props {
  converter: ConverterData;
}

const { converter } = Astro.props;
const firstDirection = converter.directions[0];
const displayName = converter.directions.length > 1
  ? `${firstDirection.from} ↔ ${firstDirection.to}`
  : `${firstDirection.from} → ${firstDirection.to}`;
const related = converters.filter(({ slug }) => slug !== converter.slug).slice(0, 4);
const baseUrl = import.meta.env.BASE_URL;
// FAQPage 结构化数据：将页面 FAQ 转为 schema.org 富搜索结果格式
const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: converter.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
// BreadcrumbList 结构化数据：与可视化面包屑 nav 对应，提升富搜索结果
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DevFormat.tools', item: new URL(baseUrl, Astro.site ?? 'https://devformat.tools').toString() },
    { '@type': 'ListItem', position: 2, name: displayName },
  ],
};
---

<Layout title={converter.title} description={converter.description} canonical={`/convert/${converter.slug}/`}>
  <article class="mx-auto max-w-6xl px-5 pb-8 pt-10 sm:px-8 sm:pt-14">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
    <nav aria-label="Breadcrumb" class="mb-8 text-sm text-stone-500">
      <a href={baseUrl} class="underline-offset-4 hover:text-teal-800 hover:underline">All tools</a>
      <span aria-hidden="true" class="mx-2 text-stone-300">/</span>
      <span>{displayName}</span>
    </nav>

    <header class="mb-8 max-w-4xl">
      <div class="mb-4 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-teal-800">
        <span>{converter.category}</span>
        <span aria-hidden="true" class="size-1 rounded-full bg-stone-300"></span>
        <span>Runs locally</span>
      </div>
      <h1 class="text-4xl font-semibold leading-[1.05] tracking-[-0.05em] text-stone-950 sm:text-6xl">{displayName} converter</h1>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-stone-600">{converter.description}</p>
    </header>

    <ConverterTool client:idle slug={converter.slug} directions={converter.directions} />

    <section class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 md:grid-cols-2" aria-labelledby="directions-title">
      <h2 id="directions-title" class="sr-only">Conversion directions</h2>
      {converter.directions.map((direction, index) => (
        <div class="bg-white p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-800">Direction {String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-xl font-semibold tracking-tight text-stone-950">{direction.from} to {direction.to}</h3>
          <p class="mt-3 leading-7 text-stone-600">{direction.summary}</p>
        </div>
      ))}
    </section>

    {converter.content && <ContentSection sections={converter.content} />}

    <FAQSection items={converter.faq} />

    <section class="mx-auto mt-16 max-w-4xl border-t border-stone-200 pt-8" aria-labelledby="related-title">
      <h2 id="related-title" class="text-xl font-semibold tracking-tight text-stone-950">Related tools</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {related.map((item) => (
          <a href={`${baseUrl}convert/${item.slug}/`} class="rounded-full border border-stone-300 bg-white px-4 py-2 text-sm text-stone-600 transition hover:border-teal-700 hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700">
            {item.directions[0].from}{item.directions.length > 1 ? ' ↔ ' : ' → '}{item.directions[0].to}
          </a>
        ))}
      </div>
    </section>
  </article>
</Layout>
