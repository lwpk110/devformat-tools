---
import ContentSection from '../components/ContentSection.astro';
import FAQSection from '../components/FAQSection.astro';
import { CardKeyConverter } from '../components/CardKeyConverter';
import { DEFAULT_SITE_URL } from '../config/site';
import Layout from '../layouts/Layout.astro';
import type { ContentSection as ContentSectionData, FAQItem } from '../types/converter';

const baseUrl = import.meta.env.BASE_URL;

const contentSections: ContentSectionData[] = [
  {
    heading: 'How card key conversion works',
    body: [
      'Paste your raw card keys (such as email----password----token or numbered format) or upload batch text files. The converter automatically extracts emails, passwords, and OAuth refresh tokens, strips noisy index prefixes and blank lines, and structures them into valid Sub2API account objects.',
      'You can switch upstream platforms (Grok, Claude, OpenAI, Gemini) and export target formats (Sub2API JSON, clean token lists, formatted cards, or CPA JSON) with one click.',
    ],
  },
  {
    heading: 'Supported platforms and data structures',
    body: [
      'Sub2API JSON output produces standard sub2api-data payloads with platform metadata, nested credentials.refresh_token, and extra credentials for effortless bulk account imports.',
      'The pure token list extracts clean refresh tokens (one per line) for fast copy-pasting into relay gateways or command-line clients.',
      'CPA format outputs array objects compatible with cliProxyAPI and related proxy relays.',
    ],
  },
  {
    heading: 'Privacy and security guarantee',
    body: [
      'All parsing, token extraction, and JSON generation run 100% in your local browser memory. No tokens, credentials, passwords, or emails are ever sent to any remote server or logged.',
      'Once you close or reload the browser tab, all memory is immediately wiped.',
    ],
  },
];

const faqItems: FAQItem[] = [
  { q: 'Is my card key or token data uploaded to any server?', a: 'No. All parsing and conversion happen entirely in your browser memory. Nothing is sent to a server, stored, or logged.' },
  { q: 'What card key formats are supported?', a: 'It supports "卡密 1: email----password----token", "email----password----token", "email----token", or pure token strings. Multiple blank lines and varying separators (----, ---, |, commas) are handled automatically.' },
  { q: 'How do I import the result into Sub2API?', a: 'Choose Sub2API JSON format, click "Download JSON", then go to your Sub2API Admin Console -> Account Management -> Import, and select the generated JSON file.' },
  { q: 'Can I convert card keys for Claude, OpenAI, or Gemini as well?', a: 'Yes. Simply click the platform toggle above the input area to switch between Grok, Claude, OpenAI, and Gemini.' },
  { q: '导入 Grok Sub2API JSON 报错或无法调用怎么办？', a: '由于 xAI 对并发验证较敏感，若导入 JSON 出现报错，建议切换到「纯 Token」格式提取 Refresh Token (RT)，并在 Sub2API 导入时使用 RT 配合「单线程验证」导入，以避免多并发触发速率风控。' },
  { q: 'What should I do if a token begins with dashes like "--"?', a: 'The parser is specially designed to handle tokens starting with negative signs or dashes without breaking the email and password delimiters.' },
];

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DevFormat.tools', item: new URL(baseUrl, Astro.site ?? new URL(DEFAULT_SITE_URL)).toString() },
    { '@type': 'ListItem', position: 2, name: 'Card Key to Sub2API Converter' },
  ],
};
---

<Layout
  title="Card Key to Sub2API Converter - Batch Grok, Claude & OpenAI Keys"
  description="Convert raw card keys (email----password----token) into Sub2API import JSON, token lists, and CPA format locally. 100% private in-browser conversion."
  canonical="/cardkey-converter/"
>
  <article class="mx-auto max-w-6xl px-5 pb-8 pt-8 sm:px-8 sm:pt-10">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqStructuredData)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
    <nav aria-label="Breadcrumb" class="mb-5 text-sm text-stone-500">
      <a href="/" class="underline-offset-4 hover:text-teal-800 hover:underline">All tools</a>
      <span aria-hidden="true" class="mx-2 text-stone-300">/</span>
      <span>Card Key to Sub2API Converter</span>
    </nav>

    <header class="mb-5 max-w-4xl">
      <div class="mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.18em] text-teal-800">
        <span>Account & Session Tools</span>
        <span aria-hidden="true" class="size-1 rounded-full bg-stone-300"></span>
        <span>Runs locally</span>
      </div>
      <h1 class="text-4xl font-semibold leading-[1.05] tracking-[-0.05em] text-stone-950 sm:text-5xl">
        Card Key to Sub2API Converter
      </h1>
      <p class="mt-3 max-w-3xl text-base leading-7 text-stone-600">
        Paste raw card keys or upload text files to convert them into Sub2API import JSON, pure token lists, or CPA format. Supports Grok, Claude, OpenAI, and Gemini accounts. Everything runs locally in your browser memory — 0 network uploads.
      </p>
    </header>

    <div class="rounded-2xl border border-stone-200 bg-white p-4 shadow-[0_18px_60px_rgba(28,25,23,0.07)] sm:p-6">
      <CardKeyConverter client:load />
    </div>

    <ContentSection sections={contentSections} />
    <FAQSection items={faqItems} />
  </article>
</Layout>
