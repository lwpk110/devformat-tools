---
import { popularTools, toolCatalog, toolCategories } from '../data/toolCatalog';
import Layout from '../layouts/Layout.astro';

const baseUrl = import.meta.env.BASE_URL;
const toolCount = toolCatalog.length;
const guides = [
  {
    href: '/guides/json-vs-csv/',
    title: 'JSON vs CSV',
    description: 'When spreadsheets win, when nested data matters, and how to avoid lossy exports.',
  },
  {
    href: '/guides/base64-vs-encryption/',
    title: 'Base64 vs Encryption',
    description: 'A plain-language guide to transport encoding, real secrecy, and where each belongs.',
  },
];
---

<Layout
  title="Free Online Developer Converters - Private JSON, CSV, YAML & More"
  description="Free online developer converters for JSON, CSV, YAML, XML, Base64, timestamps and URL encoding. Fast, private browser tools with no uploads or signup."
  canonical="/"
>
  <section class="border-b border-stone-200 bg-[#f8f7f3]">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-teal-800">Local-first developer converters</p>
      <h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.055em] text-stone-950 sm:text-7xl lg:text-[5.4rem]">
        Private developer format converters.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-stone-600 sm:text-xl">
        Convert JSON, CSV, YAML, XML, encoding, and timestamps entirely in your browser. No uploads, accounts, or waiting for a server.
      </p>
      <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-sm text-stone-600" aria-label="Service guarantees">
        <span><strong class="font-semibold text-stone-800">0</strong> network uploads</span>
        <span><strong class="font-semibold text-stone-800">{toolCount}</strong> focused tools</span>
        <span><strong class="font-semibold text-stone-800">100%</strong> browser local</span>
      </div>
    </div>
  </section>

  <section id="popular" class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <div class="mb-8 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-800">Start here</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-stone-950 sm:text-4xl">Popular tools</h2>
      </div>
      <p class="max-w-md text-sm leading-6 text-stone-600">High-frequency tools for data conversion and account migration, ordered by practical demand.</p>
    </div>

    <div class="grid overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 gap-px md:grid-cols-2">
      {popularTools.map((tool) => (
        <a href={`${baseUrl}${tool.href.replace(/^\//, '')}`} class="group min-h-48 bg-white p-6 transition hover:bg-teal-50 focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-700 sm:p-7">
          <div class="flex h-full flex-col justify-between gap-8">
            <div class="flex items-start justify-between gap-4">
              <span class="text-xs font-semibold tabular-nums text-stone-600">{String(tool.homepageRank).padStart(2, '0')}</span>
              <span aria-hidden="true" class="text-xl text-teal-800 transition-transform group-hover:translate-x-1">→</span>
            </div>
            <div>
              <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em] text-teal-800">{tool.category}</p>
              <h3 class="text-2xl font-semibold tracking-[-0.025em] text-stone-950">{tool.name}</h3>
              <p class="mt-2 line-clamp-2 text-sm leading-6 text-stone-500">{tool.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section id="all-tools" class="border-y border-stone-200 bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-800">Complete index</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-stone-950 sm:text-4xl">All tools</h2>
      </div>
      <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        {toolCategories.map((category) => (
          <section aria-labelledby={`category-${category.name.toLowerCase().replaceAll(' ', '-')}`}>
            <h3 id={`category-${category.name.toLowerCase().replaceAll(' ', '-')}`} class="border-b border-stone-200 pb-3 text-sm font-semibold text-stone-950">{category.name}</h3>
            <ul class="mt-3 grid gap-1">
              {category.tools.map((tool) => (
                <li>
                  <a href={`${baseUrl}${tool.href.replace(/^\//, '')}`} class="block rounded-lg px-2 py-2.5 text-sm leading-5 text-stone-600 transition hover:bg-stone-100 hover:text-teal-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-700">
                    {tool.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-stone-200 bg-[#f8f7f3]">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="mb-8">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-teal-800">Guides</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.035em] text-stone-950 sm:text-4xl">Deeper reading</h2>
      </div>
      <div class="grid gap-px overflow-hidden rounded-2xl border border-stone-200 bg-stone-200 md:grid-cols-2">
        {guides.map((guide) => (
          <a href={baseUrl + guide.href.replace(/^\//, '')} class="group bg-white p-6 transition hover:bg-teal-50 focus-visible:z-10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-teal-700 sm:p-7">
            <div class="flex h-full flex-col justify-between gap-8">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-teal-800">Guide</p>
                <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em] text-stone-950">{guide.title}</h3>
                <p class="mt-2 max-w-xl text-sm leading-6 text-stone-500">{guide.description}</p>
              </div>
              <span class="text-sm font-semibold text-teal-800 transition-transform group-hover:translate-x-1">Read guide →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
